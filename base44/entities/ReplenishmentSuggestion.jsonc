{
  "name": "ReplenishmentSuggestion",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string",
      "description": "ID du produit"
    },
    "product_name": {
      "type": "string",
      "description": "Nom du produit"
    },
    "warehouse_id": {
      "type": "string",
      "description": "ID de l'entrep\u00f4t"
    },
    "warehouse_name": {
      "type": "string",
      "description": "Nom de l'entrep\u00f4t"
    },
    "current_stock": {
      "type": "number",
      "description": "Stock actuel"
    },
    "min_stock": {
      "type": "number",
      "description": "Stock minimum"
    },
    "reorder_point": {
      "type": "number",
      "description": "Point de r\u00e9approvisionnement"
    },
    "suggested_quantity": {
      "type": "number",
      "description": "Quantit\u00e9 sugg\u00e9r\u00e9e"
    },
    "suggested_supplier_id": {
      "type": "string",
      "description": "Fournisseur sugg\u00e9r\u00e9"
    },
    "suggested_supplier_name": {
      "type": "string",
      "description": "Nom du fournisseur sugg\u00e9r\u00e9"
    },
    "estimated_cost": {
      "type": "number",
      "description": "Co\u00fbt estim\u00e9"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium",
      "description": "Priorit\u00e9"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "ordered",
        "rejected"
      ],
      "default": "pending",
      "description": "Statut de la suggestion"
    },
    "purchase_order_id": {
      "type": "string",
      "description": "ID du bon de commande cr\u00e9\u00e9"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date de g\u00e9n\u00e9ration"
    }
  },
  "required": [
    "product_id",
    "warehouse_id",
    "current_stock",
    "suggested_quantity"
  ]
}