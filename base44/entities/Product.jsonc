{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nom du produit fini"
    },
    "code": {
      "type": "string",
      "description": "Code unique du produit"
    },
    "sku": {
      "type": "string",
      "description": "Stock Keeping Unit"
    },
    "description": {
      "type": "string",
      "description": "Description du produit"
    },
    "unity": {
      "type": "string",
      "description": "Unit\u00e9 de mesure (kg, L, pcs, etc.)"
    },
    "type": {
      "type": "string",
      "enum": [
        "raw_material",
        "semi_finished",
        "finished_product",
        "consumable"
      ],
      "default": "finished_product",
      "description": "Type de produit"
    },
    "requires_lot_tracking": {
      "type": "boolean",
      "default": true,
      "description": "N\u00e9cessite un suivi par lot"
    },
    "lot_expiry_days": {
      "type": "number",
      "description": "Dur\u00e9e de validit\u00e9 du lot en jours"
    },
    "group_id": {
      "type": "string",
      "description": "ID du groupe propri\u00e9taire"
    },
    "slug": {
      "type": "string",
      "description": "Slug g\u00e9n\u00e9r\u00e9 automatiquement"
    },
    "image_url": {
      "type": "string",
      "description": "URL de l'image du produit"
    },
    "cost_price": {
      "type": "number",
      "description": "Prix de revient"
    },
    "selling_price": {
      "type": "number",
      "description": "Prix de vente"
    }
  },
  "required": [
    "name",
    "code"
  ]
}