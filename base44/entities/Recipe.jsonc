{
  "name": "Recipe",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Titre de la recette"
    },
    "description": {
      "type": "string",
      "description": "Description de la recette"
    },
    "code": {
      "type": "string",
      "description": "Code unique de la recette"
    },
    "version": {
      "type": "string",
      "default": "1.0",
      "description": "Version de la recette"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "obsolete"
      ],
      "default": "draft",
      "description": "Statut de la recette"
    },
    "slug": {
      "type": "string",
      "description": "Slug g\u00e9n\u00e9r\u00e9 automatiquement"
    },
    "cost": {
      "type": "number",
      "default": 0,
      "description": "Co\u00fbt total de la recette"
    },
    "type_id": {
      "type": "string",
      "description": "ID du type de recette"
    },
    "type_name": {
      "type": "string",
      "description": "Nom du type de recette"
    },
    "steps": {
      "type": "array",
      "description": "\u00c9tapes de production de la recette",
      "items": {
        "type": "object",
        "properties": {
          "lineorder": {
            "type": "integer",
            "description": "Ordre d'ex\u00e9cution de l'\u00e9tape"
          },
          "description": {
            "type": "string",
            "description": "Description de l'\u00e9tape"
          },
          "components": {
            "type": "array",
            "description": "Composants utilis\u00e9s dans cette \u00e9tape",
            "items": {
              "type": "object",
              "properties": {
                "rawmaterial_id": {
                  "type": "string"
                },
                "rawmaterial_name": {
                  "type": "string"
                },
                "quantity": {
                  "type": "number"
                },
                "unity": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "title",
    "code"
  ]
}