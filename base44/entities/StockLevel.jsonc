{
  "name": "StockLevel",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "product_sku": {
      "type": "string"
    },
    "warehouse_id": {
      "type": "string"
    },
    "warehouse_name": {
      "type": "string"
    },
    "quantity": {
      "type": "number",
      "default": 0
    },
    "reserved_quantity": {
      "type": "number",
      "default": 0
    },
    "available_quantity": {
      "type": "number",
      "default": 0
    },
    "unit_cost": {
      "type": "number",
      "default": 0
    },
    "total_value": {
      "type": "number",
      "default": 0
    },
    "min_stock_alert": {
      "type": "number",
      "default": 10,
      "description": "Seuil minimum d'alerte de stock"
    },
    "max_stock_alert": {
      "type": "number",
      "description": "Seuil maximum d'alerte de stock"
    },
    "reorder_point": {
      "type": "number",
      "description": "Point de r\u00e9approvisionnement"
    },
    "reorder_quantity": {
      "type": "number",
      "description": "Quantit\u00e9 de r\u00e9approvisionnement"
    },
    "last_movement_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "product_id",
    "warehouse_id"
  ]
}