{
  "name": "JobCard",
  "type": "object",
  "properties": {
    "card_number": {
      "type": "string",
      "description": "Num\u00e9ro de fiche"
    },
    "manufacturing_order_id": {
      "type": "string"
    },
    "manufacturing_order_number": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "workstation_id": {
      "type": "string"
    },
    "workstation_name": {
      "type": "string"
    },
    "operation": {
      "type": "string",
      "description": "Nom de l'op\u00e9ration"
    },
    "sequence": {
      "type": "number",
      "description": "Ordre d'ex\u00e9cution"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "completed",
        "on_hold"
      ],
      "default": "open"
    },
    "assigned_to": {
      "type": "string",
      "description": "Op\u00e9rateur assign\u00e9"
    },
    "planned_start": {
      "type": "string",
      "format": "date-time"
    },
    "planned_end": {
      "type": "string",
      "format": "date-time"
    },
    "actual_start": {
      "type": "string",
      "format": "date-time"
    },
    "actual_end": {
      "type": "string",
      "format": "date-time"
    },
    "planned_hours": {
      "type": "number",
      "default": 0
    },
    "actual_hours": {
      "type": "number",
      "default": 0
    },
    "quantity_to_produce": {
      "type": "number",
      "default": 0
    },
    "quantity_produced": {
      "type": "number",
      "default": 0
    },
    "scrap_quantity": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "manufacturing_order_id",
    "workstation_id",
    "operation"
  ]
}